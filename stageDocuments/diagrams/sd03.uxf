obj=_:User_~u ACTOR
obj=_:MainWindow_~mw
obj=_:HistoryPanel_~hp
obj=_:ModelViewerPanel_~mv
obj=_:AppController_~ac
obj=_:Project_~prj
obj=_:ReferenceImageSet_~rset
obj=_:ModelAgent_~ag
obj=_:Hunyuan3DAdapter_~hun
obj=_:Hunyuan3DApi_~api
obj=_:ProjectRepository_~repo
u-&gt;&gt;&gt;mw : click Build 3D model; on=u; on=mw
mw-&gt;mw + :Dialogs.confirm(uses Tencent Cloud credits)
tick=
mw-&gt;&gt;&gt;ac : buildModel(); on=ac
ac-&gt;&gt;&gt;prj : getReferenceSet(); on=prj
prj.&gt;ac : set; off=prj
ac-&gt;&gt;&gt;ag : buildMesh(set); on=ag
ag-&gt;ag + :meshViews(set)
tick=
combinedFragment=alt~a1 mw repo; ag:[no included AI-generated front view]
ag-&gt;&gt;&gt;mw : onError(BUILDING_MESH, no generated front view)
ag.&gt;ac : IllegalStateException
ac.&gt;mw : IllegalStateException
..=a1; ag:[else]
ag-&gt;&gt;&gt;hun : submitJob(views); on=hun
hun-&gt;hun + :base64Jpeg(view)
tick=
hun-&gt;&gt;&gt;api : submitProJob(params); on=api
api.&gt;hun : jobId; off=api
hun.&gt;ag : jobId; off=hun
combinedFragment=loop~l1 ag api; ag:[until DONE or FAILED, every 10 s, at most 15 min]
ag-&gt;&gt;&gt;hun : getStatus(jobId); on=hun
hun-&gt;&gt;&gt;api : queryProJob(jobId); on=api
api.&gt;hun : job; off=api
hun.&gt;ag : status; off=hun
ag-&gt;&gt;&gt;mw : onProgress(BUILDING_MESH, status)
--=l1
combinedFragment=alt~a2 mw repo; ag:[status == FAILED]
ag-&gt;&gt;&gt;mw : onError(BUILDING_MESH, message)
ag.&gt;ac : IllegalStateException
ac.&gt;mw : IllegalStateException
..=a2; ag:[status == DONE]
ag-&gt;&gt;&gt;hun : download(jobId); on=hun
hun-&gt;&gt;&gt;api : download(url, target); on=api
api.&gt;hun : zip or GLB; off=api
hun.&gt;ag : modelFile; off=hun
ag-&gt;&gt;&gt;mw : onProgress(DONE, the model is ready)
ag.&gt;ac : modelFile; off=ag
ac-&gt;&gt;&gt;repo : importFile(project, modelFile, models); on=repo
repo.&gt;ac : stored; off=repo
ac-&gt;&gt;&gt;prj : addVersion(stored); on=prj
prj-&gt;&gt;&gt;rset : copy(); on=rset
rset.&gt;prj : snapshot; off=rset
prj.&gt;ac : version; off=prj
ac-&gt;&gt;&gt;repo : save(project)
ac.&gt;mw : version; off=ac
mw-&gt;&gt;&gt;hp : showVersions(versions, current, version); on=hp
hp-&gt;&gt;&gt;mv : loadModel(version); off=hp
ref=mv mv :preview (SD06)
--=a2
--=a1
